# Copy to config/.env (git-ignored) and fill in. Names only here, never real values.
# Only the orchestrator reads this file. Plugins receive exactly the secrets their manifest lists,
# as environment variables. The stage and the console frontend never see any of them.
# You can also enter keys in the console's write-only key page (stored encrypted for your Windows account).
# An empty value counts as not set.

# Model provider keys, referenced from animatus.config.yaml as ${secret:gemini} and ${secret:openai}
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: the Cookie header of a logged-in bilibili account (SESSDATA=...; bili_jct=...; buvid3=...),
# so chat shows real names instead of masked ones. Referenced as sources.bilibili.cookie_secret: bili_cookie
BILI_COOKIE=
